# Default when at least one external output is connected.
profile external {
  output eDP-1 disable
  output "* * *" enable
  ...output "*" enable
}

# Manually enable all outputs while external outputs are connected.
profile all {
  output eDP-1 enable
  output "* * *" enable
  ...output "*" enable
}

# Manually enable only the internal output while external outputs stay connected.
profile internal {
  output eDP-1 enable
  output "* * *" disable
  ...output "*" disable
}

# Automatically enable the internal output when it is the only connected output.
profile internal {
  output eDP-1 enable
}
