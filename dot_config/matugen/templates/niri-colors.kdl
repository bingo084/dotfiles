// Generated by Matugen. Do not edit directly.

layout {
    focus-ring {
        active-gradient from="{{colors.primary.default.hex}}" to="{{colors.tertiary.default.hex}}" angle=135 in="oklab"
        inactive-color "{{colors.outline.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }

    shadow {
        color "{{colors.shadow.default.hex}}70"
        inactive-color "{{colors.shadow.default.hex}}40"
    }

    tab-indicator {
        active-color "{{colors.tertiary.default.hex}}"
        inactive-color "{{colors.outline.default.hex}}b3"
        urgent-color "{{colors.error.default.hex}}"
    }

    insert-hint {
        gradient from="{{colors.secondary.default.hex}}a6" to="{{colors.tertiary.default.hex}}a6" angle=45 relative-to="workspace-view" in="oklab"
    }
}

overview {
    backdrop-color "{{colors.surface_container_high.default.hex}}"
}

recent-windows {
    highlight {
        active-color "{{colors.tertiary.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
}
